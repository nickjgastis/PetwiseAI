{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/cron/drip-emails",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/cron/hubspot-sync",
      "schedule": "0 16 * * *"
    }
  ]
}
